FROM python:3.11-slim AS build

# Définir le répertoire de travail
WORKDIR /app

# Installer les dépendances pour psycopg2 et autres dépendances système
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copier le fichier requirements.txt et installer les dépendances Python
COPY requirements.txt /app/requirements.txt
RUN pip install --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# Copier tous les fichiers du projet dans l'image
COPY . .

# Étape 2: Configurer le serveur Nginx et le serveur de développement Django
FROM nginx:alpine AS final

# Copier le fichier de configuration Nginx dans le conteneur
COPY nginx.conf.dev /etc/nginx/conf.d/default.conf

# Copier le projet Django depuis l'étape de construction
COPY --from=build /app /app

# Créer un répertoire pour stocker les logs de Nginx et Django
RUN mkdir -p /var/log/nginx

# Installer les dépendances Python et Nginx
RUN apk add --no-cache python3 py3-pip

# Créer un environnement virtuel et installer les dépendances
RUN python3 -m venv /opt/venv
RUN /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install --no-cache-dir -r /app/requirements.txt

# # Définir le répertoire de travail final
WORKDIR /app

# Exposer les ports nécessaires
EXPOSE 80 8000

# Démarrer le serveur Django et Nginx
CMD ["sh", "-c", "source /opt/venv/bin/activate && python manage.py runserver 0.0.0.0:8000 & nginx -g 'daemon off;'"]


server {
    listen 80;  # Port sur lequel Nginx écoute (mappé dans Docker)

    server_name localhost localhost 127.0.0.1;

    # Rediriger les requêtes vers Gunicorn
    location / {
        proxy_pass http://127.0.0.1:8000;  # Gunicorn écoute sur le port 8000 en interne
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_redirect off;
    }

    # Servir les fichiers statiques
    location /static/ {
        alias /usr/share/nginx/html/static/;  # Chemin où les fichiers statiques sont copiés
    }
}
